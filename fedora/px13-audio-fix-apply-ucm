#!/usr/bin/bash
# Generate the SKU-specific ALSA UCM long-name override for the ASUS ProArt PX13.
#
# Safe to run from RPM %post, systemd, or by hand. Does not touch PipeWire
# (that needs a desktop session). No values are hardcoded to one PX13 SKU.
#
# Based on install-durable.sh from https://github.com/ftoleedo/px13-audio-fix
set -euo pipefail

LIBDIR="${PX13_LIBDIR:-/usr/share/px13-audio-fix}"
UCM="${UCM_DIR:-/usr/share/alsa/ucm2}"
MARKER="px13-audio-fix"
DETECT="$LIBDIR/px13-detect.sh"
TEMPLATE="$LIBDIR/ucm-card-override.conf.in"
CACHE="${PX13_CACHE:-/etc/px13-audio-fix.conf}"

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: $0 must run as root" >&2
    exit 1
fi

if [[ ! -r "$DETECT" ]]; then
    echo "ERROR: missing $DETECT" >&2
    exit 1
fi
# shellcheck source=/usr/share/px13-audio-fix/px13-detect.sh
. "$DETECT"

if [[ ! -f "$TEMPLATE" ]]; then
    echo "ERROR: missing $TEMPLATE" >&2
    exit 1
fi

# Diagnostic aliases from the original firmware workaround. Fedora's real
# TAS2783 blobs live under ti/audio/tas2783/ and must not be deleted.
rm -f /usr/lib/firmware/1714-1-8.bin.xz /usr/lib/firmware/1714-1-B.bin.xz

if ! CARD="$(px13_find_card)"; then
    echo "px13-audio-fix: no SoundWire ALSA card yet; skipping UCM apply"
    exit 0
fi

DRIVER="$(px13_card_driver "$CARD")" || {
    echo "ERROR: could not read the ALSA driver name of card $CARD" >&2
    exit 1
}
LONG="$(px13_card_longname "$CARD")" || {
    echo "ERROR: could not read CardLongName of card $CARD" >&2
    exit 1
}

OVERRIDE="$UCM/conf.d/$DRIVER/$LONG.conf"
install -d -m755 "$UCM/conf.d/$DRIVER"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
sed -e "s|@DRIVER@|$DRIVER|g" -e "s|@LONGNAME@|$LONG|g" "$TEMPLATE" > "$TMP"
install -m644 "$TMP" "$OVERRIDE"

if command -v restorecon >/dev/null 2>&1; then
    restorecon -F "$OVERRIDE" >/dev/null 2>&1 || true
fi

# An override installed under a different long name is never read by UCM.
shopt -s nullglob
for f in "$UCM/conf.d/$DRIVER"/*.conf; do
    [[ "$f" == "$OVERRIDE" ]] && continue
    if grep -q "$MARKER" "$f" 2>/dev/null; then
        rm -f "$f"
        echo "px13-audio-fix: removed stale override $(basename "$f")"
    fi
done

PCI="$(px13_acp_pci)" || PCI=""
umask 022
printf '# generated by px13-audio-fix on %s - do not edit by hand\nPX13_ACP_PCI=%s\nPX13_CARD_LONGNAME=%s\n' \
    "$(date '+%F %T')" "$PCI" "$LONG" > "$CACHE"
if command -v restorecon >/dev/null 2>&1; then
    restorecon -F "$CACHE" >/dev/null 2>&1 || true
fi

echo "px13-audio-fix: UCM override $OVERRIDE"
echo "px13-audio-fix: cached ACP PCI=${PCI:-?} longname=$LONG"

if command -v alsaucm >/dev/null 2>&1; then
    if alsaucm -c "$CARD" list _devices/HiFi 2>/dev/null | grep -qw Speaker; then
        echo "px13-audio-fix: UCM Speaker device is present"
    else
        echo "px13-audio-fix: UCM Speaker is not visible yet (reboot may be required so the DKMS module loads)"
    fi
fi

exit 0
